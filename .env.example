# Copie para .env (local) e cadastre as mesmas variáveis no painel da Netlify:
# Site configuration → Environment variables. Depois, refaça o deploy.

# Link REAL do checkout hospedado da Cakto (formato https://pay.cakto.com.br/<id-da-oferta>).
# Sem esta variável, os botões de compra ficam desativados com o aviso "Checkout em configuração".
VITE_CAKTO_CHECKOUT_URL=

# Parâmetros da URL de entrada repassados ao checkout.
# A documentação da Cakto confirma utm_source, utm_medium e utm_campaign nos pedidos.
# Só acrescente outros (ex.: utm_content, utm_term) depois de confirmar no painel da Cakto.
VITE_CAKTO_FORWARD_PARAMS=utm_source,utm_medium,utm_campaign

# Preço exibido. Deve ser IGUAL ao preço configurado na oferta da Cakto.
VITE_PRICE=39,90

# Prazo de garantia/arrependimento (dias) exatamente como configurado na Cakto. Deixe vazio para ocultar.
VITE_GUARANTEE_DAYS=7

# Vídeo de fundo opcional do hero (MP4/WebM leve, sem áudio, de preferência < 3 MB).
VITE_HERO_VIDEO_URL=
VITE_HERO_POSTER_URL=

# Informações legais exibidas no rodapé (deixe vazio para ocultar).
VITE_LEGAL_NAME=
VITE_LEGAL_DOCUMENT=
VITE_CONTACT_EMAIL=
